---
import Hero from '../components/Hero.jsx';
import FragranceStory from '../components/FragranceStory.jsx';
import Collection from '../components/Collection.jsx';
import Newsletter from '../components/Newsletter.jsx';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Oceano Noturno, eau de parfum da Véloris Parfums." />
    <meta name="theme-color" content="#081421" />
    <title>Oceano Noturno | Véloris Parfums</title>
    <link rel="preload" as="image" href="/assets/oceano-noturno-cenario.png" />
    <link rel="preload" as="image" href="/assets/oceano-noturno-frasco.png" />
    <link rel="preload" as="image" href="/assets/nuvens-recortadas.png" />
    <link rel="preload" as="image" href="/assets/nuvem-volumosa.png" />
    <link rel="preload" as="image" href="/assets/nuvem-arredondada.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <Hero client:load />
      <FragranceStory client:load />
      <Collection client:load />
      <Newsletter client:load />
    </main>
    <Footer />
  </body>
</html>
